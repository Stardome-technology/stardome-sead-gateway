# ── Stardome SEAD Gateway — runtime env template ──────────────────────────
# Copy to `.env` and fill in your values. The `.env` file is gitignored.
#   cp .env.example .env
#
# The gateway is the single public HTTPS entry point for a SEAD node. It
# terminates TLS, enforces auth, and routes to the internal C++ services over
# the shared `sead-network` bridge.

# ── Server ────────────────────────────────────────────────────────────────
GATEWAY_LISTEN_ADDR=:30080
# Enable TLS termination. In production set to true and provide cert/key paths.
GATEWAY_TLS_ENABLED=false
GATEWAY_TLS_CERT=
GATEWAY_TLS_KEY=

# ── Auth ──────────────────────────────────────────────────────────────────
# Bearer-token auth on all public endpoints (except /health).
GATEWAY_AUTH_ENABLED=true
# Shared secret for Bearer token validation. REQUIRED in production.
GATEWAY_AUTH_SECRET=
# Comma-separated edge token secrets (for edge-token auth).
GATEWAY_EDGE_TOKENS=

# CBOR auth-token verification (collapsed from auth-service).
GATEWAY_AUTH_CBOR_ENABLED=true
GATEWAY_AUTH_CBOR_SEAD_CORE_URL=http://sead-core:50051
GATEWAY_AUTH_CBOR_CACHE_TTL=60
GATEWAY_AUTH_CBOR_SKEW_TOLERANCE=30

# ── Observability ─────────────────────────────────────────────────────────
GATEWAY_METRICS_ENABLED=true
GATEWAY_LOG_LEVEL=info

# ── Timeouts ──────────────────────────────────────────────────────────────
GATEWAY_READ_TIMEOUT=30s
GATEWAY_WRITE_TIMEOUT=30s
GATEWAY_IDLE_TIMEOUT=90s
GATEWAY_PROXY_TIMEOUT=30s

# ── Internal C++ services (gRPC-only, Go Gateway migration phase 4.4) ─────────────────────────
# These targets are resolved on the `sead-network` bridge. They must match the
# service names/ports in the SEAD stack compose (stardome-sead).
SVC_SEAD_CORE_GRPC=sead-core:50051
SVC_EDGE_SERVICE_GRPC=edge-service:50055
SVC_STORAGE_GRPC=storage-gateway:50052
SVC_SOURCE_DATA_GRPC=source-data-service:50053
# Port the gateway's gRPC Sync server listens on (gateway↔gateway cross-node fetch).
GATEWAY_GRPC_PORT=50054